#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
extra_maven_args=()

if [[ -n "${MAVEN_ARGS:-}" ]]; then
  read -r -a extra_maven_args <<< "${MAVEN_ARGS}"
fi

cd "${repo_root}"

mvn "${extra_maven_args[@]}" -Pexamples -DskipTests test-compile exec:java -Dexec.args="$*"
